END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "Manager  (&F)"
    BEGIN
        MENUITEM "Guild Manager",               ID_GUILD_MANAGER
        MENUITEM "Server Manager",              ID_SERVER_MANAGER
        MENUITEM SEPARATOR
        MENUITEM SEPARATOR
        MENUITEM "Exit (&X)",                   ID_APP_EXIT
    END
    POPUP "View (&V)"
    BEGIN
        MENUITEM "Toolbar (&T)",                ID_VIEW_TOOLBAR
        MENUITEM "Status Bar (&S)",             ID_VIEW_STATUS_BAR
        MENUITEM "PLUS LOG",                    ID_PLUS_LOG
    END
    POPUP "About (&H)"
    BEGIN
        MENUITEM "Exdb Info(&A)...",            ID_APP_ABOUT
    END
END

IDR_POPUP_EDIT MENU
BEGIN
    POPUP "편집"
    BEGIN
        MENUITEM "잘라내기(&T)\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V",            ID_EDIT_PASTE
    END
END


